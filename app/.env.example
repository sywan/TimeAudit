# One-time publisher setup. End users only click Continue with Google.
# Create a Google OAuth Web application client and allow the deployed origin.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: YouVersion Platform App Key for in-card daily scripture.
# This is embedded in the public browser bundle; do not use a server-only secret.
VITE_YOUVERSION_APP_KEY=

# Optional: anonymous site usage analytics through Umami Cloud.
# Website ID and a public share URL are safe to expose in a browser build.
# The share URL is optional; it enables the public statistics link in the app.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SHARE_URL=
